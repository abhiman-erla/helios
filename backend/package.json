{
  "name": "taskops-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TaskOps API: Express + PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "express": "5.2.1",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "supertest": "7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
