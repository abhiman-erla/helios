# Rendered at container start by the nginx image's entrypoint (envsubst), which
# fills in ${NGINX_LOCAL_RESOLVERS} (the container's DNS server), ${BACKEND_URL},
# ${BACKEND_HOST} and ${APP_VERSION}. It only touches variables that exist in the
# environment, so nginx's own, such as $host, are left alone. The Dockerfile gives
# each of these a default, because an undefined one would reach nginx unchanged.
server {
    listen 8080;            # unprivileged image: non-root users can't bind port 80
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;      # don't reveal the nginx version

    # Basic security headers.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ALB and Docker health checks, and the deploy check, which waits for this
    # to report the new commit.
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok ${APP_VERSION}\n";
    }

    # Forward /api to the backend: the backend container in local Compose, its
    # public URL on Render. In AWS the ALB routes /api/* straight to the backend,
    # so requests never reach this block. Using a variable + resolver makes nginx
    # look up the hostname per request instead of at startup, so the container
    # still starts in AWS where no host called "backend" exists.
    #
    # Over the public internet, Host and the TLS server name must both name the
    # backend, not the frontend address the visitor used.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Vite puts content hashes in asset filenames, so they can be cached for a
    # year; a new build produces new filenames.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths fall back to index.html. Never cache
    # index.html, so users always get the latest asset filenames after a deploy.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri /index.html;
    }
}
